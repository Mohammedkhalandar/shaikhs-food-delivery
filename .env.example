# Local development only. Use a managed PostgreSQL URL and unique credentials in production.
DATABASE_URL="postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5433/shaikhs?schema=public"
JWT_SECRET="GENERATE_A_UNIQUE_SECRET_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
APP_URL="http://localhost:3000"
# Optional NEW local demo database only: set a private unique value of at least 16 characters.
SEED_DEMO_PASSWORD=""

# Disabled by default. Only rzp_test_ keys are accepted; never use live credentials.
RAZORPAY_TEST_ENABLED="false"
# Set true only after the actual provider checklist in docs/RAZORPAY_SANDBOX.md passes.
RAZORPAY_SANDBOX_VERIFIED="false"
RAZORPAY_KEY_ID="rzp_test_REPLACE_WITH_TEST_KEY"
RAZORPAY_KEY_SECRET="REPLACE_WITH_TEST_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_WEBHOOK_SECRET"
# Comma-separated trusted image CDN hostnames; rebuild after changing. Empty = local images only.
MENU_IMAGE_HOSTS=""

# External email/SMS/WhatsApp adapters are not enabled. Local outbox requires a disposable loopback DB.
MAIL_DELIVERY_MODE="disabled"
# Server-only 32-byte hex key. Generate/load locally with scripts/use-local-mail.ps1; never NEXT_PUBLIC.
DEV_MAIL_KEY=""

# Application never initiates external payouts; release startup enforces disabled state.
EXTERNAL_PAYOUTS_ENABLED="false"
# Operator-only backup settings: supply BACKUP_SIGNING_KEY via a private secret environment,
# BACKUP_EXPECT_DATABASE explicitly, and RESTORE_ADMIN_URL only for new local restore targets.
# Never put real backup keys in NEXT_PUBLIC variables or source control.
